# Copy this file to .env and fill in your project's values.
# .env itself is gitignored and must never be committed.
#
# These VITE_* values are the public Supabase project URL and
# publishable (anon) key — safe for client-side use by Supabase's
# design. Never put a service-role key or any other secret in a
# VITE_-prefixed variable; anything prefixed VITE_ is bundled into
# the client-side JavaScript and is publicly visible.

VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=
